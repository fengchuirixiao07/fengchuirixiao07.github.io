import gmpy2
n=int()
e=(0x3)
c=int(0x10652cdfaa6b63f6d7bd1109da08181e500e5643f5b240a9024bfa84d5f2cac9310562978347bb232d63e7289283871efab83d84ff5a7b64a94a79d34cfbd4ef121723ba1f663e514f83f6f01492b4e13e1bb4296d96ea5a353d3bf2edd2f449c03c4a3e995237985a596908adc741f32365)
i=0
while True:
    m=i*n+c
    if gmpy2.iroot(m,e)[1]:
        m=gmpy2.iroot(m,e)[0]
        print(long_to_bytes(m))
        break
    i +=1
